{
  "name": "beast-booter dev (Ubuntu 26.04)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      "USERNAME": "dev",
      "USER_UID": "1000",
      "USER_GID": "1000"
    }
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",
  "runArgs": [
    "--device=/dev/kvm",
    "--group-add=${localEnv:BB_KVM_GID:991}"
  ],
  "init": true,
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "containerEnv": {
    "BB_DEVCONTAINER": "1"
  },
  "postCreateCommand": "bin/bb-dev setup --yes --no-image",
  "portsAttributes": {
    "5900": {
      "label": "QEMU VNC (bb-dev vm --display vnc)",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "timonwong.shellcheck",
        "eclipse-cdt.cdt-gdb-vscode"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
