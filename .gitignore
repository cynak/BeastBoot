# Local rootless toolchain (scripts/bootstrap-tools.sh)
/.tools/

# Build and test outputs
/dist/
/out/
__pycache__/
*.pyc
.pytest_cache/

# Secure Boot private keys must never be committed.
/keys/*.key
/keys/*.p12
/keys/*.pem
/keys/*.crt
/keys/*.cer
!/keys/README.md

# Python dev virtualenv (bin/bb-dev setup)
/.venv/

# ruff cache
/.ruff_cache/

# build/build.sh staging directory (removed when a build ends)
/.dist-staging.*/

# Generated SBOM / vulnerability reports describe one build; each release
# publishes its own (see sbom/README.md). The triage decisions are source.
/sbom/*
!/sbom/README.md
!/sbom/vex.openvex.json
# generated, evidence-backed triage (scripts/kernel_vex.py, ...); the scanner's proposals stay local
!/sbom/vex.*.openvex.json
/sbom/vex.proposed.openvex.json

# Top-level hidden folders are local only, except the CI and release workflows
/.*/
# ...and .tools also as a symlink (a worktree linking the main checkout's .tools):
# /.*/ matches folders only, and a committed .tools link replaces the real folder
/.tools
!/.github/
/.github/*
!/.github/workflows/
!/.github/FUNDING.yml

# Security testing (security/): scan results, the generated report and the
# finding/triage records stay local while findings are open (public repo).
# THREAT_MODEL.md and scope.json are source. /.build/ is covered by /.*/ above.
/security/findings.json
/security/SECURITY_REPORT.md
/security/manual.json
/security/triage.json

# macOS Finder metadata
.DS_Store
