{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Installer: info --json (dev image)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "beastbooter",
      "args": ["info", "--image", "${workspaceFolder}/out/dev/beast-booter-dev.img", "--json"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/installer",
        "PATH": "${workspaceFolder}/.tools/bin:${env:PATH}"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "presentation": { "group": "1-installer", "order": 1 }
    },
    {
      "name": "Installer: install a scratch image…",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "beastbooter",
      "args": [
        "install",
        "--image", "${workspaceFolder}/out/dev/debug-install.img",
        "--size", "2G",
        "--layout", "${input:installLayout}",
        "--fs", "${input:installFs}",
        "--yes"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/installer",
        "PATH": "${workspaceFolder}/.tools/bin:${env:PATH}"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "presentation": { "group": "1-installer", "order": 2 }
    },
    {
      "name": "Installer: custom arguments…",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "beastbooter",
      "args": "${command:pickArgs}",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/installer",
        "PATH": "${workspaceFolder}/.tools/bin:${env:PATH}"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "presentation": { "group": "1-installer", "order": 3 }
    },
    {
      "name": "bb-dev: doctor",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "bbdev",
      "args": ["doctor"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/devtools:${workspaceFolder}/installer"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "presentation": { "group": "2-bb-dev", "order": 1 }
    },
    {
      "name": "bb-dev: image --fixtures --debug --force",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "bbdev",
      "args": ["image", "--fixtures", "--debug", "--force"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/devtools:${workspaceFolder}/installer"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "presentation": { "group": "2-bb-dev", "order": 2 }
    },
    {
      "name": "bb-dev: vm --print-cmd…",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "bbdev",
      "args": ["vm", "--mode", "${input:vmMode}", "--print-cmd"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/devtools:${workspaceFolder}/installer"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "presentation": { "group": "2-bb-dev", "order": 3 }
    },
    {
      "name": "bb-dev: menu-sync",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "bbdev",
      "args": ["menu-sync"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/devtools:${workspaceFolder}/installer"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "presentation": { "group": "2-bb-dev", "order": 4 }
    },
    {
      "name": "bb-dev: debug-config --show",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "bbdev",
      "args": ["debug-config", "--show"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/devtools:${workspaceFolder}/installer"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "presentation": { "group": "2-bb-dev", "order": 5 }
    },
    {
      "name": "bb-dev: custom arguments…",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "bbdev",
      "args": "${command:pickArgs}",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/devtools:${workspaceFolder}/installer"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "presentation": { "group": "2-bb-dev", "order": 6 }
    },
    {
      "name": "pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "pytest",
      "args": ["-q", "${file}"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/out/dev/vscode.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/devtools:${workspaceFolder}/installer",
        "PATH": "${workspaceFolder}/.tools/bin:${env:PATH}"
      },
      "console": "integratedTerminal",
      "justMyCode": false,
      "presentation": { "group": "3-tests", "order": 1 }
    },
    {
      "name": "pytest: current file, selected test name",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "pytest",
      "args": ["-q", "${file}", "-k", "${selectedText}"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/out/dev/vscode.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/devtools:${workspaceFolder}/installer",
        "PATH": "${workspaceFolder}/.tools/bin:${env:PATH}"
      },
      "console": "integratedTerminal",
      "justMyCode": false,
      "presentation": { "group": "3-tests", "order": 2 }
    },
    {
      "name": "Python: debug tests (Test Explorer)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "purpose": ["debug-test"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/out/dev/vscode.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/devtools:${workspaceFolder}/installer",
        "PATH": "${workspaceFolder}/.tools/bin:${env:PATH}"
      },
      "console": "integratedTerminal",
      "justMyCode": false,
      "presentation": { "group": "3-tests", "order": 3 }
    },
    {
      "name": "GRUB (BIOS): attach gdb to QEMU",
      "type": "gdbtarget",
      "request": "attach",
      "program": "${workspaceFolder}/out/vm/beast-booter-dev/gdb-pc-kernel.exec",
      "cwd": "${workspaceFolder}",
      "gdb": "gdb",
      "gdbArguments": ["-nx"],
      "run": "preserve",
      "preLaunchTask": "gdb: prepare VS Code session (pc)",
      "target": {
        "host": "localhost",
        "port": "1234",
        "connectCommands": ["source ${workspaceFolder}/out/vm/beast-booter-dev/gdb-pc.gdb"]
      },
      "presentation": { "group": "4-grub", "order": 1 }
    },
    {
      "name": "GRUB (UEFI): attach gdb to QEMU",
      "type": "gdbtarget",
      "request": "attach",
      "program": "${workspaceFolder}/out/vm/beast-booter-dev/gdb-efi-kernel.exec",
      "cwd": "${workspaceFolder}",
      "gdb": "gdb",
      "gdbArguments": ["-nx"],
      "run": "preserve",
      "preLaunchTask": "gdb: prepare VS Code session (efi)",
      "target": {
        "host": "localhost",
        "port": "1234",
        "connectCommands": ["source ${workspaceFolder}/out/vm/beast-booter-dev/gdb-efi.gdb"]
      },
      "presentation": { "group": "4-grub", "order": 2 }
    }
  ],
  "inputs": [
    {
      "id": "installLayout",
      "type": "pickString",
      "description": "Partition table",
      "options": ["msdos", "gpt"],
      "default": "msdos"
    },
    {
      "id": "installFs",
      "type": "pickString",
      "description": "Data partition filesystem",
      "options": ["exfat", "fat32", "ntfs"],
      "default": "exfat"
    },
    {
      "id": "vmMode",
      "type": "pickString",
      "description": "Firmware mode",
      "options": ["uefi", "bios", "sb", "sb-enrolled", "sb-fresh"],
      "default": "uefi"
    }
  ]
}
