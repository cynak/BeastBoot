# beast-net top-level packages (Ubuntu 26.04 "resolute", amd64).
#
#   <package>[=<version>] <role> [suite=<series>]   (suite: another Ubuntu series, released pockets only)
#
# roles: kernel (vmlinuz), modules (module subset, modules.list), tool
# (programs + Python, userland.list), data (CA bundle, terminfo), lib
# (libraries; normally added by lock.py from the tools' DT_NEEDED entries and
# the packages' Depends - list one here only when it is dlopen()ed).
#
# After editing, run:  python3 -I build/beastnet/lock.py
# which downloads the packages (apt verifies them against the signed archive
# index), resolves the libraries and rewrites packages.lock with every .deb's
# SHA-256. The build itself only ever uses packages.lock.

linux-image-7.3.0-9-generic=7.3.0-9.9         kernel   suite=stonking
linux-modules-7.3.0-9-generic=7.3.0-9.9       modules  suite=stonking
busybox=1:1.37.0-7ubuntu1                      tool  # dynamic: uses the locked libc6 (busybox-static embeds its own glibc copy)
kmod=34.2-2ubuntu2                             tool
wpasupplicant=2:2.11-0ubuntu5                  tool
iw=6.17-1                                      tool
mokutil=0.7.2-2                                tool  # "Trust Ubuntu's Secure Boot key" (build/trust/README.md)
python3.14-minimal=3.14.4-1ubuntu0.2           tool
libpython3.14-minimal=3.14.4-1ubuntu0.2        tool
libpython3.14-stdlib=3.14.4-1ubuntu0.2         tool
ca-certificates=20260816ubuntu0.26.04.1        data
ncurses-base=6.6+20251231-1                    data
wireless-regdb=2026.05.30-0ubuntu1~26.04.1      data  # signed regulatory.db for cfg80211 (ISC licence)

# disk tools (docs/DISK_TOOLS.md): RAID/LVM/LUKS assembly, rescue, health, filesystem checks
mdadm=4.5-5ubuntu1.1                           tool
lvm2=2.03.31-2ubuntu3                          tool
dmsetup=2:1.02.205-2ubuntu3                    tool
cryptsetup-bin=2:2.8.4-1ubuntu4                tool
gddrescue=1.30-1                               tool  # universe
smartmontools=7.5-2                            tool
util-linux=2.41.3-3ubuntu2.2                   tool  # blkid, lsblk (JSON), blockdev, partx, findmnt
fdisk=2.41.3-3ubuntu2.2                        tool  # sfdisk
mount=2.41.3-3ubuntu2.2                        tool  # losetup (partition scan, read-only)
e2fsprogs=1.47.2-3ubuntu4                      tool  # e2fsck -n, dumpe2fs
xfsprogs=6.18.0-3                              tool  # xfs_repair -n, xfs_db
btrfs-progs=6.17.1-1build1                     tool  # btrfs check --readonly, show, restore

# dlopen()ed (no DT_NEEDED entry points at them)
libzstd1=1.5.7+dfsg-3                          lib   # kmod: reading .ko.zst modules
libgcc-s1=16-20260322-1ubuntu1                 lib   # glibc: pthread_cancel/pthread_exit unwinding
