#!/bin/sh
# shellcheck disable=SC2154  # interface, ip, mask, router, dns: set by udhcpc in the environment
# Test-only udhcpc script (busybox udhcpc passes the lease in the environment).
case "$1" in
deconfig)
	ip addr flush dev "$interface"
	ip link set "$interface" up
	;;
bound|renew)
	ip addr flush dev "$interface"
	ip addr add "$ip/${mask:-24}" dev "$interface"
	if [ -n "$router" ] && ! ip route | grep -q '^default'; then
		ip route add default via "${router%% *}" dev "$interface"
		: >/etc/resolv.conf
		for d in $dns; do echo "nameserver $d" >>/etc/resolv.conf; done
	fi
	echo "$ip" >"/tmp/ip.$interface"
	;;
esac
exit 0
