# beast-net userland: which files of each locked package go into the initramfs.
#
#   <package> <glob>...     take matching paths from that package (relative to /)
#   exclude <glob>...       never ship matching paths (checked after everything else,
#                           also against the generated busybox applet links)
#
# '*' does not cross '/', '**' matches any depth. Matching directories are
# created as needed; symlinks are kept as symlinks (their targets must be
# shipped too, the build checks it).
#
# Not listed here:
#   - shared libraries: every DT_NEEDED of every shipped ELF file is resolved
#     against the locked packages (packages.lock, role "lib") and exactly those
#     library files (and their symlink chains) are shipped;
#   - linux-modules-*: selected by modules.list (closure via modules.dep);
#   - linux-image-*: only /boot/vmlinuz-<kver>, which goes next to the initrd;
#   - ca-certificates: /etc/ssl/certs/ca-certificates.crt is built from it
#     (see mkinitrd.py, same result as update-ca-certificates).

busybox               usr/bin/busybox
kmod                  usr/bin/kmod usr/bin/lsmod usr/sbin/depmod usr/sbin/insmod usr/sbin/lsmod
kmod                  usr/sbin/modinfo usr/sbin/modprobe usr/sbin/rmmod
wpasupplicant         usr/sbin/wpa_supplicant usr/sbin/wpa_cli usr/bin/wpa_passphrase
iw                    usr/sbin/iw
mokutil               usr/bin/mokutil
python3.14-minimal    usr/bin/python3.14
libpython3.14-minimal usr/lib/python3.14/** etc/python3.14/**
libpython3.14-stdlib  usr/lib/python3.14/**
ncurses-base          usr/share/terminfo/**
wireless-regdb        lib/firmware/regulatory.db lib/firmware/regulatory.db.p7s

# --- disk tools (docs/DISK_TOOLS.md) -----------------------------------------------
# No udev rules, no systemd units, no cron/init scripts, no daemons (smartd,
# mdmon stays: IMSM/DDF need it), no mkfs/repair/resize tools: sources are
# read-only. /etc/lvm/lvm.conf comes from beastnet/rootfs (udev off, read-only scans).
mdadm                 usr/sbin/mdadm usr/sbin/mdmon
lvm2                  usr/sbin/lvm usr/sbin/pv* usr/sbin/vg* usr/sbin/lv*
dmsetup               usr/sbin/dmsetup
cryptsetup-bin        usr/sbin/cryptsetup
gddrescue             usr/bin/ddrescue usr/bin/ddrescuelog
smartmontools         usr/sbin/smartctl usr/share/smartmontools/drivedb.h
util-linux            usr/sbin/blkid usr/sbin/blockdev usr/bin/lsblk usr/bin/partx usr/bin/findmnt
fdisk                 usr/sbin/sfdisk
mount                 usr/sbin/losetup
e2fsprogs             usr/sbin/e2fsck usr/sbin/fsck.ext2 usr/sbin/fsck.ext3 usr/sbin/fsck.ext4 usr/sbin/dumpe2fs
xfsprogs              usr/sbin/xfs_repair usr/sbin/xfs_db usr/sbin/xfs_info
btrfs-progs           usr/bin/btrfs usr/bin/btrfs-find-root
exclude usr/sbin/pvmove usr/sbin/pvcreate usr/sbin/pvremove usr/sbin/pvresize usr/sbin/pvchange
exclude usr/sbin/vgcreate usr/sbin/vgremove usr/sbin/vgextend usr/sbin/vgreduce usr/sbin/vgrename usr/sbin/vgmerge usr/sbin/vgsplit
exclude usr/sbin/vgexport usr/sbin/vgimport usr/sbin/vgimportclone usr/sbin/vgconvert usr/sbin/vgcfgrestore
exclude usr/sbin/lvcreate usr/sbin/lvremove usr/sbin/lvextend usr/sbin/lvreduce usr/sbin/lvresize usr/sbin/lvrename
exclude usr/sbin/lvconvert usr/sbin/lvmpolld usr/sbin/lvmdump usr/sbin/lvmsadc usr/sbin/lvmsar

# dlopen()ed, so not found through DT_NEEDED:
libzstd1              usr/lib/x86_64-linux-gnu/libzstd.so.1*
libgcc-s1             usr/lib/x86_64-linux-gnu/libgcc_s.so.1

# Python: no test suites, GUI, IDE, docs browser, pip bootstrap, or modules
# whose libraries we do not ship (sqlite3, dbm.gnu/ndbm). lzma, bz2, zstd,
# ctypes, readline, decimal, asyncio etc. stay: they are small and their
# libraries are already here.
exclude usr/lib/python3.14/test/** usr/lib/python3.14/**/tests/** usr/lib/python3.14/**/test/**
exclude usr/lib/python3.14/idlelib/** usr/lib/python3.14/tkinter/** usr/lib/python3.14/turtledemo/**
exclude usr/lib/python3.14/turtle.py usr/lib/python3.14/ensurepip/** usr/lib/python3.14/pydoc_data/**
exclude usr/lib/python3.14/sqlite3/** usr/lib/python3.14/lib-dynload/_sqlite3.*
exclude usr/lib/python3.14/lib-dynload/_dbm.* usr/lib/python3.14/lib-dynload/_gdbm.*
exclude usr/lib/python3.14/lib-dynload/_test* usr/lib/python3.14/lib-dynload/_ctypes_test.*
exclude usr/lib/python3.14/lib-dynload/xx* usr/lib/python3.14/lib-dynload/_xxtestfuzz.*
exclude usr/lib/python3.14/lib-dynload/_remote_debugging.*
exclude usr/lib/python3.14/__phello__/** usr/lib/python3.14/**/*.exe
exclude usr/lib/python3.14/config-*/**

# Unused code with open CVEs (sbom/vex.userland.openvex.json names each one).
# Python modules the app never imports (not in the import closure of
# beastnet/python/beastnet + runtime.json; shutil, which argparse loads, only
# imports tarfile/zipfile inside make_archive/unpack_archive): tarfile,
# zipfile, configparser, csv (Sniffer), xml + its users plistlib/xmlrpc
# (ElementTree, expat wrapper), urllib.request + robotparser, tempfile, and
# uuid + _uuid (its libuuid1 then leaves packages.lock).
exclude usr/lib/python3.14/tarfile.py usr/lib/python3.14/zipfile/** usr/lib/python3.14/configparser.py
exclude usr/lib/python3.14/csv.py usr/lib/python3.14/xml/** usr/lib/python3.14/plistlib.py
exclude usr/lib/python3.14/xmlrpc/** usr/lib/python3.14/urllib/request.py
exclude usr/lib/python3.14/urllib/robotparser.py usr/lib/python3.14/tempfile.py
exclude usr/lib/python3.14/uuid.py usr/lib/python3.14/lib-dynload/_uuid.*
# busybox applet links nothing runs (init, udhcpc.script, mdev.conf and the
# app call only runtime.json "binaries"); busybox sh has no standalone-applet
# mode, so without a link the shell cannot run them either: archive
# extractors (tar, cpio, unzip, rpm, dpkg, ar), wget + its TLS helper,
# httpd, netstat, the DHCPv6 client, awk.
exclude usr/*bin/tar usr/*bin/cpio usr/*bin/unzip usr/*bin/rpm usr/*bin/rpm2cpio
exclude usr/*bin/dpkg usr/*bin/dpkg-deb usr/*bin/ar usr/*bin/wget usr/*bin/ssl_client
exclude usr/*bin/httpd usr/*bin/netstat usr/*bin/udhcpc6 usr/*bin/awk
