#!/bin/sh
# beast-booter portable (Linux): the command line interface.
#
#   ./beast-booter --help
#   sudo ./beast-booter install --device /dev/sdX      (writing a drive needs root)
#   ./beast-booter install --image my.img --size 8G    (image files: no root)
#
# Runs only what is in this folder (runtime/, app/, payload/dist); installs nothing.
#   -s  ignore ~/.local Python packages      -E  ignore PYTHON* variables
#   -B  write no .pyc files into this folder -S  no site-packages, no .pth files
set -e

# Find this folder, also when started through a symlink (e.g. ~/bin/beast-booter).
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname -- "$self")/$link ;;
  esac
done
here=$(CDPATH='' cd -- "$(dirname -- "$self")" && pwd -P)

BEAST_BOOTER_DIST=$here/payload/dist
export BEAST_BOOTER_DIST
unset TCL_LIBRARY TK_LIBRARY
exec "$here/runtime/bin/python3" -s -E -B -S "$here/app/beast_booter_launch.py" "$@"
